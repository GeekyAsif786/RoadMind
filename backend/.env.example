APP_NAME=Smart Traffic Optimization System
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://traffic:traffic@postgres:5432/traffic_manager
AUTO_CREATE_TABLES=true
ENABLE_AUTH=false
API_KEY=dev-insecure-key-change-me
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
JOB_QUEUE_ENABLED=true
TRAFFIC_MODEL=random_forest
DETECTION_FRESHNESS_SECONDS=10
DETECTION_WORKER_COUNT=2
DETECTION_BATCH_SIZE=4
UPLOAD_MAX_BYTES=10485760
RATE_LIMIT_PER_MINUTE=120
METRICS_ENABLED=true
ENABLE_YOLO=false
YOLO_MODEL_PATH=yolov8n.pt
YOLO_DEVICE=cpu
MODEL_DIR=/app/models
DEFAULT_LANE_CAPACITY=50
HIGHWAY_LANE_CAPACITY=80
SERVICE_ROAD_CAPACITY=25
MIN_GREEN_SECONDS=15
MAX_GREEN_SECONDS=90
YELLOW_SECONDS=4
RED_CLEARANCE_SECONDS=3
PEDESTRIAN_CLEARANCE_SECONDS=7
ENABLE_PEDESTRIAN_PHASE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
