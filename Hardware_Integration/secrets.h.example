#pragma once

// RoadMind Edge device secrets template.
// Copy this file to "secrets.h" in the same sketch folder and fill in
// real values. secrets.h is gitignored and must NEVER be committed.

// Wi-Fi network the ESP32 device connects to.
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Device credential issued by the RoadMind backend (device auth).
#define ROADMIND_DEVICE_CREDENTIAL "your-device-credential-token"

// Base URL of the RoadMind backend API (no trailing slash).
#define ROADMIND_BASE_URL "http://your-backend-host:8000"
